<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.paulislava.human4captcha</string>

    <!-- Тот же Node, что в разработке (nvm v22): нативный биндинг
         better-sqlite3 собран под него, и на Node из Homebrew (v26) служба
         падает с ERR_DLOPEN_FAILED. При смене версии nvm путь надо обновить
         и пересобрать модуль: npm rebuild better-sqlite3. -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/pkondratov/.nvm/versions/node/v22.22.0/bin/node</string>
        <string>/Users/pkondratov/Desktop/Projects/human4captcha/dist/index.js</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/pkondratov/Desktop/Projects/human4captcha</string>

    <!-- Ступень Claude запускает CLI, а он ищет по PATH свои зависимости. -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/Users/pkondratov/.nvm/versions/node/v22.22.0/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/pkondratov/Desktop/Projects/human4captcha/data/service.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/pkondratov/Desktop/Projects/human4captcha/data/service.error.log</string>
</dict>
</plist>
