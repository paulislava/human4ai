# Внутри контейнера порт всегда 3200, наружу его пробрасывает HOST_PORT.
PORT=3200
HOST_PORT=4020
DATABASE_PATH=./data/human4ai.sqlite

# Публичный адрес службы (нужен для вебхука навыка Алисы и для MCP с других
# машин). Пусто -> локальный http://127.0.0.1:<HOST_PORT>.
PUBLIC_URL=

# Токены клиентов: «токен:имя,токен:имя». Имя видно в логах — понятно, кто просит.
CLIENT_TOKENS=dev-token:paulismapa-scraper

# Ступень 1 — GigaChat через gpt2giga-proxy (OpenAI-совместимый)
GPT2GIGA_BASE_URL=http://localhost:8090
GIGACHAT_MODEL=GigaChat-2-Max
GPT2GIGA_API_KEY=

# Ступень 2 — Claude через CLI. В контейнере CLI нет: он вызывается на хосте
# через hostshim/claude-shim.mjs (см. README). Пусто -> ступень выключена.
CLAUDE_SHIM_URL=
CLAUDE_SHIM_TOKEN=
# Локальный запуск без контейнера: путь к CLI и его токен.
CLAUDE_CLI_PATH=/opt/homebrew/bin/claude
ANTHROPIC_MODEL=claude-opus-5
CLAUDE_TIMEOUT_MS=90000

# Ступень 3 — человек в Telegram (отдельный бот только под капчи)
TELEGRAM_CAPTCHA_BOT_TOKEN=
# Определяется установщиком: он ждёт твоего сообщения боту и берёт id оттуда.
TELEGRAM_CHAT_ID=
# Прокси к Bot API: из RU-сети api.telegram.org недоступен.
TELEGRAM_PROXY=

# Сколько ждать ответа человека, если клиент не задал свой таймаут
DEFAULT_TIMEOUT_MS=600000

# ── Голосовой канал: вопрос произносит Яндекс-Станция ──────────────
# Секрет в пути вебхука приватного навыка Алисы «Мой код»: /alice/<секрет>.
VOICE_ALICE_SECRET=
# Кому разрешён навык: user_id аккаунта и/или application_id устройства.
VOICE_ALICE_ALLOWED_USERS=
# OAuth-токен Яндекса со скоупом quasar (тот же, что у проекта assistant).
VOICE_YANDEX_TOKEN=
# Колонка по умолчанию: номер, имя или device_id.
VOICE_STATION=
# Подписи колонок: «device_id:имя, device_id:имя».
VOICE_STATION_NAMES=
# Прокси в домашнюю локалку (pcproxy на домашней машине) — нужен, только если
# служба работает ВНЕ той сети, где стоят колонки.
VOICE_PC_PROXY=
# Колонки: заполняется автоматически `node scripts/find-stations.mjs --env`
# (запускать на машине в той же сети). Формат: device_id:host:port:platform:имя
VOICE_STATIONS=
# Сколько голосовой вопрос ждёт ответа (по умолчанию сутки).
VOICE_TTL_MS=86400000
# Дублировать голосовой вопрос в Telegram (0 — не дублировать).
VOICE_ALSO_TELEGRAM=1

# ── MCP для сессий Claude Code ─────────────────────────────────────
MCP_TOKEN=
MCP_MAX_WAIT_MS=120000

# Исходящие локальные voice-клиенты: «token:client-id».
VOICE_CLIENT_TOKENS=

# ID приложения Яндекс OAuth. Пусто -> публичный client_id «Яндекс Музыки»:
# своё приложение регистрировать не нужно, установщик открывает страницу выдачи
# токена в браузере сам (сам токен — в VOICE_YANDEX_TOKEN).
YANDEX_OAUTH_CLIENT_ID=
